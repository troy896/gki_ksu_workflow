From: Cashiris <troy896@gmail.com>
Date: Mon, 12 Oct 2026 05:35:46 -0500
Subject: [PATCH] 1

---
 kernel/selinux/rules.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index a9d4f672..166a57e5 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -15,12 +15,10 @@ static void reset_avc_cache()
 #if ((!defined(KSU_COMPAT_USE_SELINUX_STATE)) || LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0))
 	avc_ss_reset(0);
 	selnl_notify_policyload(0);
-	selinux_status_update_policyload(0);
 #else
 	struct selinux_avc *avc = selinux_state.avc;
 	avc_ss_reset(avc, 0);
 	selnl_notify_policyload(0);
-	selinux_status_update_policyload(&selinux_state, 0);
 #endif
 	selinux_xfrm_notify_policyload();
 }
